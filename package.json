{
  "name": "dsh-plugin-kit",
  "version": "0.1.0-draft.1",
  "private": true,
  "type": "module",
  "description": "Thin author tooling for ordinary DSH Cordis plugins: zero-dependency scaffold generator, declaration-check adapter, manifest checks and host-only template. Not an SDK and not a replacement for Cordis.",
  "engines": {
    "node": ">=24.9.0"
  },
  "bin": {
    "dsh-plugin-kit": "./src/cli.js"
  },
  "main": "./src/index.js",
  "types": "./src/index.d.ts",
  "exports": {
    ".": {
      "types": "./src/index.d.ts",
      "default": "./src/index.js"
    },
    "./cleanup": {
      "types": "./src/cleanup.d.ts",
      "default": "./src/cleanup.js"
    },
    "./managed-registration": {
      "types": "./src/managed-registration.d.ts",
      "default": "./src/managed-registration.js"
    },
    "./admission": {
      "types": "./src/admission.d.ts",
      "default": "./src/admission.js"
    },
    "./admission-provider": {
      "types": "./src/admission-provider.d.ts",
      "default": "./src/admission-provider.js"
    },
    "./cli": "./src/cli.js",
    "./package.json": "./package.json"
  },
  "files": [
    "src/",
    "templates/",
    "skills/"
  ],
  "scripts": {
    "test": "node --test \"tests/*.test.js\""
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lbn2011/dsh-plugin-kit.git"
  }
}
